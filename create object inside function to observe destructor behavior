#include <iostream>
using namespace std;

class BankAccount {
private:
    int accountNumber;
    double balance;

public:
    // Constructor
    BankAccount(int accNo, double bal) {
        accountNumber = accNo;
        balance = bal;
        cout << "Constructor called for Account Number: "
             << accountNumber << endl;
    }

    // Function to display details
    void display() {
        cout << "Account Number: " << accountNumber << endl;
        cout << "Balance: " << balance << endl;
    }

    // Destructor
    ~BankAccount() {
        cout << "Destructor called for Account Number: "
             << accountNumber << endl;
    }
};

// Function to observe destructor behavior
void createAccounts() {
    BankAccount b1(101, 5000.0);
    BankAccount b2(102, 8000.0);

    cout << "\nInside createAccounts() function\n";
    b1.display();
    b2.display();

} // Destructor will be called here when function ends

int main() {

    cout << "Program Started\n\n";

    createAccounts();

    cout << "\nBack in main() function\n";

    return 0;
}

